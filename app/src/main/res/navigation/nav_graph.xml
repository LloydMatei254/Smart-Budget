<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Auth Flow -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.smartbudget.presentation.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.smartbudget.presentation.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_register_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Main Flow -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.smartbudget.presentation.dashboard.DashboardFragment"
        android:label="Dashboard">
        <action
            android:id="@+id/action_dashboard_to_expenses"
            app:destination="@id/expensesFragment" />
        <action
            android:id="@+id/action_dashboard_to_income"
            app:destination="@id/incomeFragment" />
        <action
            android:id="@+id/action_dashboard_to_categories"
            app:destination="@id/categoriesFragment" />
        <action
            android:id="@+id/action_dashboard_to_transactions"
            app:destination="@id/transactionsFragment" />
        <action
            android:id="@+id/action_dashboard_to_reports"
            app:destination="@id/reportsFragment" />
        <action
            android:id="@+id/action_dashboard_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_dashboard_to_add_expense"
            app:destination="@id/addEditExpenseFragment" />
        <action
            android:id="@+id/action_dashboard_to_add_income"
            app:destination="@id/addEditIncomeFragment" />
    </fragment>

    <!-- Expenses -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.example.smartbudget.presentation.expenses.ExpensesFragment"
        android:label="Expenses">
        <action
            android:id="@+id/action_expenses_to_add"
            app:destination="@id/addEditExpenseFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditExpenseFragment"
        android:name="com.example.smartbudget.presentation.expenses.AddEditExpenseFragment"
        android:label="Add Expense">
        <argument
            android:name="expenseId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Income -->
    <fragment
        android:id="@+id/incomeFragment"
        android:name="com.example.smartbudget.presentation.income.IncomeFragment"
        android:label="Income">
        <action
            android:id="@+id/action_income_to_add"
            app:destination="@id/addEditIncomeFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditIncomeFragment"
        android:name="com.example.smartbudget.presentation.income.AddEditIncomeFragment"
        android:label="Add Income">
        <argument
            android:name="incomeId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Categories -->
    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.example.smartbudget.presentation.categories.CategoriesFragment"
        android:label="Categories" />

    <!-- Transactions -->
    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.example.smartbudget.presentation.transactions.TransactionsFragment"
        android:label="Transactions">
        <action
            android:id="@+id/action_transactions_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_transactions_to_addExpense"
            app:destination="@id/addEditExpenseFragment" />
        <action
            android:id="@+id/action_transactions_to_reports"
            app:destination="@id/reportsFragment" />
        <action
            android:id="@+id/action_transactions_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- Reports -->
    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.example.smartbudget.presentation.reports.ReportsFragment"
        android:label="Reports">
        <action
            android:id="@+id/action_reports_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_reports_to_transactions"
            app:destination="@id/transactionsFragment" />
        <action
            android:id="@+id/action_reports_to_addExpense"
            app:destination="@id/addEditExpenseFragment" />
        <action
            android:id="@+id/action_reports_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- Settings -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.smartbudget.presentation.settings.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settings_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_settings_to_transactions"
            app:destination="@id/transactionsFragment" />
        <action
            android:id="@+id/action_settings_to_addExpense"
            app:destination="@id/addEditExpenseFragment" />
        <action
            android:id="@+id/action_settings_to_reports"
            app:destination="@id/reportsFragment" />
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
